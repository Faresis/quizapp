{
  "id": "math-checking-05-independent",
  "kind": "quiz",
  "title": "Session 5 · Focus checking · Own approach",
  "description": "Ten tasks for inspecting supplied information, preserving details and completing instructions. All values and rules are supplied.",
  "revision": 2,
  "definition": {
    "title": "Session 5 · Focus checking · Own approach",
    "domain": "attention_practice",
    "intent": "assessment",
    "instructions": "Every calculation and rule you need is supplied. Read each source and choose the response that follows it. Work at a comfortable pace using your usual approach.",
    "presentation": {
      "mode": "one_at_a_time",
      "navigation": "free"
    },
    "timing": {
      "test_duration_ms": null,
      "question_duration_ms": null,
      "pause_policy": "not_allowed"
    },
    "retry_policy": {
      "retries_allowed": false,
      "max_attempts": 1,
      "cooldown_seconds": 0,
      "report_score": "first"
    },
    "feedback": {
      "reveal": "guardian_only"
    },
    "questions": [
      {
        "id": "copy-all-terms",
        "type": "single_select",
        "points": 1,
        "prompt": "SOURCE: 30 + 15 = 45. The calculation is already checked. Which copy preserves the WHOLE statement?",
        "options": [
          {
            "id": "a",
            "text": "30 = 45"
          },
          {
            "id": "b",
            "text": "15 = 45"
          },
          {
            "id": "c",
            "text": "30 + 15 = 45"
          },
          {
            "id": "d",
            "text": "30 + 15 = 15"
          }
        ],
        "answer_key": [
          "c"
        ],
        "skill_tags": [
          "preserve_all_terms"
        ],
        "explanation": "The complete source includes 30, +15 and =45."
      },
      {
        "id": "copy-input",
        "type": "single_select",
        "points": 1,
        "prompt": "SOURCE: Evaluate f(-3). Which instruction is copied exactly? You do not need to evaluate f.",
        "options": [
          {
            "id": "a",
            "text": "Evaluate f(3)."
          },
          {
            "id": "b",
            "text": "Evaluate f(-3)."
          },
          {
            "id": "c",
            "text": "Evaluate -f(3)."
          },
          {
            "id": "d",
            "text": "Evaluate f(-8)."
          }
        ],
        "answer_key": [
          "b"
        ],
        "skill_tags": [
          "copy_signs_and_numbers"
        ],
        "explanation": "The negative sign belongs inside the parentheses, and the input is 3."
      },
      {
        "id": "handoff",
        "type": "single_select",
        "points": 1,
        "prompt": "A checked work log says: Step A produces 6 + 14 = 20. Step B must receive the COMPLETE result of Step A. Which handoff follows the log?",
        "options": [
          {
            "id": "a",
            "text": "Pass 6 to Step B."
          },
          {
            "id": "b",
            "text": "Pass 14 to Step B."
          },
          {
            "id": "c",
            "text": "Pass 6 + 20 to Step B."
          },
          {
            "id": "d",
            "text": "Pass 20 to Step B."
          }
        ],
        "answer_key": [
          "d"
        ],
        "skill_tags": [
          "preserve_intermediate_value"
        ],
        "explanation": "The source already states the full result is 20."
      },
      {
        "id": "requested-field",
        "type": "single_select",
        "points": 1,
        "prompt": "REFERENCE CARD: Domain means input times. Range means output heights. Recorded times: 0 to 8 minutes. Recorded heights: 10 to 50 feet. The request asks for RANGE only. Which response uses the requested field?",
        "options": [
          {
            "id": "a",
            "text": "Output heights, 10 to 50 feet."
          },
          {
            "id": "b",
            "text": "Input times, 0 to 8 minutes."
          },
          {
            "id": "c",
            "text": "Output heights, 0 to 8 feet."
          },
          {
            "id": "d",
            "text": "Input times, 10 to 50 minutes."
          }
        ],
        "answer_key": [
          "a"
        ],
        "skill_tags": [
          "select_requested_information"
        ],
        "explanation": "The card defines range as output heights."
      },
      {
        "id": "boundary",
        "type": "single_select",
        "points": 1,
        "prompt": "COPY CARD: x < -5 OR x > 1. Copy this rule exactly. No solving is needed.",
        "options": [
          {
            "id": "a",
            "text": "x ≤ -5 OR x ≥ 1"
          },
          {
            "id": "b",
            "text": "x < -5 AND x > 1"
          },
          {
            "id": "c",
            "text": "x < -5 OR x > 1"
          },
          {
            "id": "d",
            "text": "-5 < x < 1"
          }
        ],
        "answer_key": [
          "c"
        ],
        "skill_tags": [
          "preserve_boundaries_and_logic"
        ],
        "explanation": "Both strict signs and OR must survive the copy."
      },
      {
        "id": "requested-index",
        "type": "single_select",
        "points": 1,
        "prompt": "A checked table lists a(16) = 96, a(17) = 104, a(18) = 112. The instruction says: report the 17th term. Which answer follows it?",
        "options": [
          {
            "id": "a",
            "text": "96"
          },
          {
            "id": "b",
            "text": "104"
          },
          {
            "id": "c",
            "text": "112"
          },
          {
            "id": "d",
            "text": "17"
          }
        ],
        "answer_key": [
          "b"
        ],
        "skill_tags": [
          "track_requested_index"
        ],
        "explanation": "Use the table entry labeled a(17)."
      },
      {
        "id": "count-label",
        "type": "single_select",
        "points": 1,
        "prompt": "A checked report contains two different fields: INCREMENTS = 42; TERMS = 43. The request asks how many TERMS. Which response copies the requested field?",
        "options": [
          {
            "id": "a",
            "text": "42 terms"
          },
          {
            "id": "b",
            "text": "42 increments"
          },
          {
            "id": "c",
            "text": "43 increments"
          },
          {
            "id": "d",
            "text": "43 terms"
          }
        ],
        "answer_key": [
          "d"
        ],
        "skill_tags": [
          "distinguish_count_labels"
        ],
        "explanation": "The requested field is TERMS, whose supplied value is 43."
      },
      {
        "id": "rule-type",
        "type": "single_select",
        "points": 1,
        "prompt": "REFERENCE CARD: An explicit rule uses n directly. A recursive rule uses the previous term a(n - 1) and a starting value. The request asks for the RECURSIVE rule. Which option follows that definition?",
        "options": [
          {
            "id": "a",
            "text": "a(1) = 4; a(n) = a(n - 1) + 3 for n ≥ 2"
          },
          {
            "id": "b",
            "text": "a(n) = 4 + 3(n - 1)"
          },
          {
            "id": "c",
            "text": "a(n) = 3n + 1"
          },
          {
            "id": "d",
            "text": "a(n) = 4 × 3^(n - 1)"
          }
        ],
        "answer_key": [
          "a"
        ],
        "skill_tags": [
          "follow_rule_definition"
        ],
        "explanation": "Only the first option supplies a start and refers to the previous term."
      },
      {
        "id": "complete-answer",
        "type": "single_select",
        "points": 1,
        "prompt": "The request has TWO parts: report the supplied total, then explain it using the supplied item count. FACT CARD: total = $48; attachments = 6. Which response completes both parts accurately?",
        "options": [
          {
            "id": "a",
            "text": "The total is $48."
          },
          {
            "id": "b",
            "text": "There are 6 attachments."
          },
          {
            "id": "c",
            "text": "The total is $48 for 6 attachments."
          },
          {
            "id": "d",
            "text": "The total is $6 for 48 attachments."
          }
        ],
        "answer_key": [
          "c"
        ],
        "skill_tags": [
          "complete_requested_parts"
        ],
        "explanation": "The complete response includes both supplied facts with their correct labels."
      },
      {
        "id": "final-audit",
        "type": "single_select",
        "points": 1,
        "prompt": "Use this rule: If a copied answer disagrees with its SOURCE, replace it with the exact source text. SOURCE: Room 17, at 4:30. COPIED ANSWER: Room 71, at 4:30. Which final answer follows the rule?",
        "options": [
          {
            "id": "a",
            "text": "Room 71, at 4:30."
          },
          {
            "id": "b",
            "text": "Room 17, at 4:30."
          },
          {
            "id": "c",
            "text": "Room 17, at 3:40."
          },
          {
            "id": "d",
            "text": "Room 71, at 3:40."
          }
        ],
        "answer_key": [
          "b"
        ],
        "skill_tags": [
          "audit_and_correct"
        ],
        "explanation": "The room number was transposed. The time was already correct."
      }
    ]
  }
}
