{
  "id": "math-checking-05-checklist",
  "kind": "quiz",
  "title": "Session 5 · Focus checking · Read, keep, check",
  "description": "Ten tasks for inspecting supplied information, preserving details and completing instructions. All values and rules are supplied.",
  "revision": 2,
  "definition": {
    "title": "Session 5 · Focus checking · Read, keep, check",
    "domain": "attention_practice",
    "intent": "training",
    "instructions": "Every calculation and rule you need is supplied. Use READ → KEEP → CHECK. READ the exact request. KEEP all signs, numbers, terms and labels. CHECK your choice against the source and every requested part. Work at a comfortable pace.",
    "presentation": {
      "mode": "one_at_a_time",
      "navigation": "free"
    },
    "timing": {
      "test_duration_ms": null,
      "question_duration_ms": null,
      "pause_policy": "not_allowed"
    },
    "retry_policy": {
      "retries_allowed": false,
      "max_attempts": 1,
      "cooldown_seconds": 0,
      "report_score": "first"
    },
    "feedback": {
      "reveal": "guardian_only"
    },
    "questions": [
      {
        "id": "copy-all-terms",
        "type": "single_select",
        "points": 1,
        "prompt": "SOURCE: 24 + 12 = 36. The calculation is already checked. Which copy preserves the WHOLE statement?",
        "options": [
          {
            "id": "a",
            "text": "24 + 12 = 12"
          },
          {
            "id": "b",
            "text": "24 = 36"
          },
          {
            "id": "c",
            "text": "12 = 36"
          },
          {
            "id": "d",
            "text": "24 + 12 = 36"
          }
        ],
        "answer_key": [
          "d"
        ],
        "skill_tags": [
          "preserve_all_terms"
        ],
        "explanation": "Keep both terms and the supplied result."
      },
      {
        "id": "copy-input",
        "type": "single_select",
        "points": 1,
        "prompt": "SOURCE: Evaluate g(-7). Which instruction is copied exactly? You do not need to evaluate g.",
        "options": [
          {
            "id": "a",
            "text": "Evaluate g(-7)."
          },
          {
            "id": "b",
            "text": "Evaluate g(7)."
          },
          {
            "id": "c",
            "text": "Evaluate -g(7)."
          },
          {
            "id": "d",
            "text": "Evaluate g(-1)."
          }
        ],
        "answer_key": [
          "a"
        ],
        "skill_tags": [
          "copy_signs_and_numbers"
        ],
        "explanation": "Preserve the function name, sign and digit."
      },
      {
        "id": "handoff",
        "type": "single_select",
        "points": 1,
        "prompt": "A checked work log says: Step A produces 8 + 11 = 19. Step B must receive the COMPLETE result of Step A. Which handoff follows the log?",
        "options": [
          {
            "id": "a",
            "text": "Pass 8 to Step B."
          },
          {
            "id": "b",
            "text": "Pass 11 to Step B."
          },
          {
            "id": "c",
            "text": "Pass 19 to Step B."
          },
          {
            "id": "d",
            "text": "Pass 8 + 19 to Step B."
          }
        ],
        "answer_key": [
          "c"
        ],
        "skill_tags": [
          "preserve_intermediate_value"
        ],
        "explanation": "The full result is supplied as 19."
      },
      {
        "id": "requested-field",
        "type": "single_select",
        "points": 1,
        "prompt": "REFERENCE CARD: Domain means input times. Range means output heights. Recorded times: 0 to 12 minutes. Recorded heights: 5 to 40 feet. The request asks for RANGE only. Which response uses the requested field?",
        "options": [
          {
            "id": "a",
            "text": "Input times, 0 to 12 minutes."
          },
          {
            "id": "b",
            "text": "Output heights, 5 to 40 feet."
          },
          {
            "id": "c",
            "text": "Output heights, 0 to 12 feet."
          },
          {
            "id": "d",
            "text": "Input times, 5 to 40 minutes."
          }
        ],
        "answer_key": [
          "b"
        ],
        "skill_tags": [
          "select_requested_information"
        ],
        "explanation": "Copy the output-height field."
      },
      {
        "id": "boundary",
        "type": "single_select",
        "points": 1,
        "prompt": "COPY CARD: x < -4 OR x > 2. Copy this rule exactly. No solving is needed.",
        "options": [
          {
            "id": "a",
            "text": "-4 < x < 2"
          },
          {
            "id": "b",
            "text": "x ≤ -4 OR x ≥ 2"
          },
          {
            "id": "c",
            "text": "x < -4 AND x > 2"
          },
          {
            "id": "d",
            "text": "x < -4 OR x > 2"
          }
        ],
        "answer_key": [
          "d"
        ],
        "skill_tags": [
          "preserve_boundaries_and_logic"
        ],
        "explanation": "Preserve strict boundaries and OR."
      },
      {
        "id": "requested-index",
        "type": "single_select",
        "points": 1,
        "prompt": "A checked table lists a(21) = 75, a(22) = 80, a(23) = 85. The instruction says: report the 22nd term. Which answer follows it?",
        "options": [
          {
            "id": "a",
            "text": "80"
          },
          {
            "id": "b",
            "text": "75"
          },
          {
            "id": "c",
            "text": "85"
          },
          {
            "id": "d",
            "text": "22"
          }
        ],
        "answer_key": [
          "a"
        ],
        "skill_tags": [
          "track_requested_index"
        ],
        "explanation": "Read the entry labeled a(22)."
      },
      {
        "id": "count-label",
        "type": "single_select",
        "points": 1,
        "prompt": "A checked report contains two different fields: INCREMENTS = 35; TERMS = 36. The request asks how many TERMS. Which response copies the requested field?",
        "options": [
          {
            "id": "a",
            "text": "35 terms"
          },
          {
            "id": "b",
            "text": "35 increments"
          },
          {
            "id": "c",
            "text": "36 terms"
          },
          {
            "id": "d",
            "text": "36 increments"
          }
        ],
        "answer_key": [
          "c"
        ],
        "skill_tags": [
          "distinguish_count_labels"
        ],
        "explanation": "TERMS is the requested field."
      },
      {
        "id": "rule-type",
        "type": "single_select",
        "points": 1,
        "prompt": "REFERENCE CARD: An explicit rule uses n directly. A recursive rule uses the previous term a(n - 1) and a starting value. The request asks for the RECURSIVE rule. Which option follows that definition?",
        "options": [
          {
            "id": "a",
            "text": "a(n) = 7 + 2(n - 1)"
          },
          {
            "id": "b",
            "text": "a(1) = 7; a(n) = a(n - 1) + 2 for n ≥ 2"
          },
          {
            "id": "c",
            "text": "a(n) = 2n + 5"
          },
          {
            "id": "d",
            "text": "a(n) = 7 × 2^(n - 1)"
          }
        ],
        "answer_key": [
          "b"
        ],
        "skill_tags": [
          "follow_rule_definition"
        ],
        "explanation": "The recursive option includes the start and previous term."
      },
      {
        "id": "complete-answer",
        "type": "single_select",
        "points": 1,
        "prompt": "The request has TWO parts: report the supplied total, then explain it using the supplied item count. FACT CARD: total = $35; attachments = 4. Which response completes both parts accurately?",
        "options": [
          {
            "id": "a",
            "text": "There are 4 attachments."
          },
          {
            "id": "b",
            "text": "The total is $4 for 35 attachments."
          },
          {
            "id": "c",
            "text": "The total is $35."
          },
          {
            "id": "d",
            "text": "The total is $35 for 4 attachments."
          }
        ],
        "answer_key": [
          "d"
        ],
        "skill_tags": [
          "complete_requested_parts"
        ],
        "explanation": "Include both fields with their correct meaning."
      },
      {
        "id": "final-audit",
        "type": "single_select",
        "points": 1,
        "prompt": "Use this rule: If a copied answer disagrees with its SOURCE, replace it with the exact source text. SOURCE: Gate 26, at 5:15. COPIED ANSWER: Gate 62, at 5:15. Which final answer follows the rule?",
        "options": [
          {
            "id": "a",
            "text": "Gate 26, at 5:15."
          },
          {
            "id": "b",
            "text": "Gate 62, at 5:15."
          },
          {
            "id": "c",
            "text": "Gate 26, at 5:51."
          },
          {
            "id": "d",
            "text": "Gate 62, at 5:51."
          }
        ],
        "answer_key": [
          "a"
        ],
        "skill_tags": [
          "audit_and_correct"
        ],
        "explanation": "Correct the transposed gate number while preserving the time."
      }
    ]
  }
}
